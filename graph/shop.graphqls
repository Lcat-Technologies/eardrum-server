#returns a merchant's data
type Merchant {
  username: String!
  phone_number: String!
  account_balance_in_cents: Int!
  pin_enrollment_status: Boolean!
  transactions(
    limit: Int = 10
    offset: Int = 0
    startTime: Time
    endTime: Time
  ): [Transaction!]
}

#fields required for adding a new merchant to the system
input NewMerchant {
  username: String!
  phone_number: String!
  password: String!
}

#fields required when logging device information to the system
input NewDevice {
  device_id: String!
  model: String!
}

#returns the status of sending an OTP code to a specific number
type SendCodeStatus {
  phone_number: String!
  success: Boolean!
}

extend type Query {
  getMerchant: Merchant
  getMerchants: [Merchant!]
}

extend type Mutation {
  createMerchant(input: NewMerchant!): Merchant
  verifyMerchant(phone_number: String!, otp: String!, device_info: NewDevice!): Authorization!
  sendCode(phone_number: String!): SendCodeStatus
  merchantLogin(phone_number: String!, password: String!, device_info: NewDevice!): Authorization!
  forgotMerchantPassword(phone_number: String!): SendCodeStatus
  requestMerchantPasswordReset(phone_number: String!, otp: String!, device_info: NewDevice!): Authorization!
  resetMerchantPassword(new_password: String!): Merchant
  refreshToken: Authorization!
  updateMerchantPinCode(new_pincode: String!): Merchant!
}
