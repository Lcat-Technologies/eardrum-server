#returns a product category's data
type Category {
  id: Int!
  createdAt: Time!
  updatedAt: Time!
  name: String!
  description: String!
  products: [Product!]
}

#fields required for adding a new product category to the system
input NewCategory {
  name: String!
  description: String!
}

extend type Mutation {
  createCategory(input: NewCategory!): Category!
  addProductToCategory(productids: [Int!]!, categoryid: Int!): Category!
  deleteCategory(categoryid: Int!): Boolean!
  removeProductsFromCategory(productids: [Int!]!, categoryid: Int!): Category!
}
