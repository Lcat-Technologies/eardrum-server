#returns a transaction's data
type TransactionMerchant{
  username: String!
}

type TransactionUser{
  username: String!
}

type Transaction {
  transaction_id: String!
  createdAt: Time!
  updatedAt: Time!
  total_amount_in_cents: Int!
  transaction_cost_in_cents: Int!
  user_username: String!
  merchant_username: String!
}


#fields required for adding a new amount based transaction to the system
input NewAmountTransaction {
  amount_in_cents: Int!
  qr_code: String!
  pin_code: String!
}

extend type Mutation {
  createAmountTransaction(input: NewAmountTransaction!): Transaction
}