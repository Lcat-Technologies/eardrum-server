schema {
  query: Query
  mutation: Mutation
}

type Query {
  getDummys: [Dummy]!
  getDummy(id: Int): Dummy
}

type Mutation {
   createDummy(name: String!): Dummy
}

type Dummy {
  id: Int!
  name: String!
}

enum Role {
  MERCHANT
  USER
}

type Authorization{
  token: String!
  role: Role!
  pin_enrollment_status: Boolean!
  face_enrollment_status: Boolean!
}